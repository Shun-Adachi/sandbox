# --- Claude API ---
ANTHROPIC_API_KEY=
MODEL_ID=claude-opus-5

# --- Snowflake 接続(トライアルアカウント可)---
# アカウント識別子: 例 abc12345.ap-northeast-1.aws
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# パスワードまたは PAT(プログラマティックアクセストークン)。
# PAT を使う場合は SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN も設定する
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=SNOWFLAKE_SAMPLE_DATA
SNOWFLAKE_SCHEMA=TPCH_SF1
# read-only ロールでの接続を推奨(未設定ならユーザーのデフォルトロール)
SNOWFLAKE_ROLE=

# --- 安全弁 ---
MAX_RESULT_ROWS=100
QUERY_TIMEOUT_SECONDS=30
